# ==============================================================================
# FlowIntel.AI — Environment Configuration Template
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection URI (Local or MongoDB Atlas)
# Example: mongodb://127.0.0.1:27017/flowintel_ai
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/flowintel_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/flowintel_ai

# Frontend Client URL (CORS allowed origins)
CLIENT_URL=http://localhost:5173

# Optional AI API Key (e.g. Gemini / OpenAI for custom live expansions)
AI_API_KEY=
